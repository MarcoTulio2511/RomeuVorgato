# Frontend (Vite) — somente chaves PÚBLICAS. Nunca coloque a service_role key aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Apenas para os testes de RLS (tests/rls) — rodam em Node, nunca vão para o bundle.
# Use um projeto Supabase de TESTE/local. A service_role é usada só para criar usuários de teste.
RLS_SUPABASE_URL=http://127.0.0.1:54321
RLS_SUPABASE_ANON_KEY=
RLS_SUPABASE_SERVICE_ROLE_KEY=
